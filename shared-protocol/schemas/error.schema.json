{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-sena.local/shared-protocol/schemas/error.schema.json",
  "title": "Project-SENA error",
  "allOf": [
    {
      "$ref": "./common.schema.json#/$defs/messageEnvelope"
    },
    {
      "properties": {
        "type": {
          "const": "error"
        },
        "payload": {
          "type": "object",
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}

